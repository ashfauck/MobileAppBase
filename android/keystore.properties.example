# Copy to android/keystore.properties (git-ignored) for local release builds.
#
# Generate an upload keystore once per app:
#
#   keytool -genkeypair -v \
#     -storetype PKCS12 \
#     -keystore release.keystore \
#     -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Back this file and the .keystore up somewhere safe and private. If you are
# NOT enrolled in Play App Signing, losing it means you can never update the
# app again under the same listing.

storeFile=release.keystore
storePassword=
keyAlias=upload
keyPassword=
