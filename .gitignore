# ───────────────────────── template additions ─────────────────────────

# Environment files: .env.dev/.staging/.prod ARE committed on purpose (they hold
# only public, build-time values). The generic .env is a local convenience copy.
.env
.env.local

# Signing material — never commit these.
android/keystore.properties
android/*.keystore
android/app/*.keystore
!android/app/debug.keystore
*.p8
*.p12
*.mobileprovision
*.cer

# Firebase configuration (per-project, per-environment).
android/app/google-services.json
android/app/src/*/google-services.json
ios/Firebase/*/GoogleService-Info.plist
ios/GoogleService-Info.plist

# Fastlane
fastlane/.env
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/README.md

# NOTE: the files generated by scripts/apply-app-identity.js
#   ios/Config/*.xcconfig, android/app/identity.gradle, src/config/identity.generated.ts
# are deliberately COMMITTED, not ignored. Xcode's project.pbxproj references the
# xcconfigs and TypeScript imports the generated module, so a fresh clone must be
# buildable before anyone runs npm install. They are regenerated (and diffed) by
# `npm run identity`, which also runs automatically on postinstall.

# Build output
build/
coverage/
*.ipa
*.aab
*.apk

# Ruby
vendor/bundle
