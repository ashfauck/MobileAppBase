# Development environment
# Loaded by react-native-config via ENVFILE=.env.dev
#
# IMPORTANT: react-native-config bakes these into the NATIVE BINARY at build time.
# They are NOT secret — anyone can extract them from an .ipa/.apk.
# Never put API secrets, signing keys, or private tokens here.

APP_ENV=dev
API_URL=https://api.dev.example.com
API_TIMEOUT_MS=15000

# Leave empty to disable Sentry locally.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

ENABLE_DEV_MENU=true
LOG_LEVEL=debug
