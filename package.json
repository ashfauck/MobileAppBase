{
  "name": "mobileappbase",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">= 22.11.0"
  },
  "scripts": {
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "android": "npm run android:dev",
    "android:dev": "ENVFILE=.env.dev react-native run-android --mode=devDebug --appIdSuffix dev",
    "android:staging": "ENVFILE=.env.staging react-native run-android --mode=stagingDebug --appIdSuffix staging",
    "android:prod": "ENVFILE=.env.prod react-native run-android --mode=prodDebug",
    "ios": "npm run ios:dev",
    "ios:dev": "ENVFILE=.env.dev react-native run-ios --scheme MobileAppBase-Dev --mode Debug-Dev",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios --scheme MobileAppBase-Staging --mode Debug-Staging",
    "ios:prod": "ENVFILE=.env.prod react-native run-ios --scheme MobileAppBase --mode Debug-Prod",
    "pods": "cd ios && bundle exec pod install && cd ..",
    "pods:update": "cd ios && bundle exec pod install --repo-update && cd ..",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "clean:ios": "rm -rf ios/build ios/Pods",
    "clean:metro": "watchman watch-del-all && rm -rf $TMPDIR/metro-* $TMPDIR/haste-map-*",
    "identity": "node ./scripts/apply-app-identity.js",
    "postinstall": "node ./scripts/apply-app-identity.js"
  },
  "dependencies": {
    "@notifee/react-native": "9.1.8",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-firebase/app": "26.2.0",
    "@react-native-firebase/messaging": "26.2.0",
    "@react-navigation/bottom-tabs": "7.18.16",
    "@react-navigation/native": "7.3.16",
    "@react-navigation/native-stack": "7.18.8",
    "@sentry/react-native": "8.22.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.19.0",
    "i18next": "26.3.6",
    "immer": "^11.1.16",
    "react": "19.2.3",
    "react-i18next": "17.0.11",
    "react-native": "0.86.2",
    "react-native-bootsplash": "7.3.2",
    "react-native-config": "1.6.1",
    "react-native-device-info": "15.0.2",
    "react-native-edge-to-edge": "1.8.1",
    "react-native-gesture-handler": "3.1.0",
    "react-native-keychain": "10.0.0",
    "react-native-localize": "3.7.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-permissions": "5.6.1",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "5.8.1",
    "react-native-screens": "4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.11.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@tanstack/eslint-plugin-query": "5.91.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  }
}
