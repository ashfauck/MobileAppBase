# Copy to fastlane/.env and fill in for local Fastlane runs.
# fastlane/.env is git-ignored. On CI these come from GitHub Actions secrets.

# ─── Apple ────────────────────────────────────────────────────────────────
APPLE_ID=you@example.com
DEVELOPER_PORTAL_TEAM_ID=ABCDE12345
APP_STORE_CONNECT_TEAM_ID=123456789

# App Store Connect API key (preferred over Apple ID + password: not tied to a
# person, and never triggers 2FA on CI).
# Create at: App Store Connect → Users and Access → Integrations → App Store Connect API
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Base64 of the downloaded .p8 file: base64 -i AuthKey_XXXX.p8 | pbcopy
APP_STORE_CONNECT_API_KEY=

# ─── fastlane match (code signing) ────────────────────────────────────────
# A PRIVATE git repo that stores encrypted certificates and profiles.
MATCH_GIT_URL=git@github.com:your-org/certificates.git
MATCH_PASSWORD=a-long-random-passphrase

# ─── Android ──────────────────────────────────────────────────────────────
ANDROID_KEYSTORE_FILE=/absolute/path/to/release.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=
# Google Play service account JSON with "Release manager" permission.
PLAY_STORE_JSON_KEY_PATH=/absolute/path/to/play-service-account.json

# ─── Sentry (optional) ────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-org
SENTRY_PROJECT=mobileappbase
